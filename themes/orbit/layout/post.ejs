<div id="reading-progress" aria-hidden="true"></div>
<section class="post-banner content-shell"><a class="back-link" href="<%- url_for('/archives/') %>">← 返回文章归档</a><div class="post-topline"><% page.categories.each(category => { %><a class="category-label" href="<%- url_for(category.path) %>"><%= category.name %></a><% }); %><span class="mono">JOURNAL ENTRY</span></div><h1><%= page.title %></h1><p class="post-description"><%= page.description || '' %></p><div class="post-byline"><span class="small-avatar">P_</span><span><%= config.author %></span><span>·</span><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY 年 MM 月 DD 日') %></time><span>·</span><span><%= Math.max(1,Math.ceil(strip_html(page.content).length/450)) %> 分钟阅读</span></div></section>
<div class="content-shell reading-shell"><article><div class="post-content"><%- page.content %></div><div class="article-end"><p class="eyebrow">THANKS FOR READING</p><div class="post-tags"><% page.tags.each(tag => { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><a href="https://github.com/PushyTao/PushyTao.github.io" target="_blank" rel="noopener noreferrer">在 GitHub 查看本站源码 ↗</a></div><nav class="post-pagination" aria-label="相邻文章"><% if(page.prev) { %><a href="<%- url_for(page.prev.path) %>"><span>← 上一篇</span><strong><%= page.prev.title %></strong></a><% } %><% if(page.next) { %><a href="<%- url_for(page.next.path) %>"><span>下一篇 →</span><strong><%= page.next.title %></strong></a><% } %></nav></article><aside class="toc-panel"><p class="eyebrow">ON THIS PAGE</p><h2>文章目录</h2><%- toc(page.content, {list_number:false}) %><a href="#main" class="toc-top">↑ 返回文章顶部</a></aside></div>
