<section class="page-banner content-shell"><p class="eyebrow">THE ARCHIVE</p><h1><%= is_category() ? page.category : is_tag() ? '# ' + page.tag : '文章归档' %><span class="cyan">.</span></h1><p>沿着时间的轨迹，重温每一次探索。<%= is_category() || is_tag() ? '本页' : '共' %> <%= is_category() || is_tag() ? page.posts.length : site.posts.length %> 篇文章。</p></section>
<div class="content-shell archive-shell"><div class="archive-list"><% let year = ''; page.posts.each(post => { const currentYear = date(post.date, 'YYYY'); if (year !== currentYear) { year = currentYear; %><h2 class="archive-year"><%= year %><span> / YEAR</span></h2><% } %><article class="archive-entry"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time><div><h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3><p><%= post.description || '' %></p><div class="post-tags"><% post.tags.forEach(tag => { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div></div><a class="archive-arrow" href="<%- url_for(post.path) %>" aria-label="阅读：<%= post.title %>">↗</a></article><% }); %><% if(page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'← 上一页',next_text:'下一页 →'}) %></nav><% } %></div><%- partial('_partial/sidebar') %></div>
