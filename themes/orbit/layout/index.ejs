<% const poems = site.data.poems; const openingPoem = poems[0]; %>
<section class="hero hero-poetry" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <img class="hero-art" src="<%- url_for('/images/orbit-hero.svg') %>" alt="" fetchpriority="high" width="980" height="800">
  <div class="hero-inner"><div class="hero-copy">
    <p class="eyebrow poetry-eyebrow"><span class="poetry-seal" aria-hidden="true">诗</span> 与诗相逢 · 字里山河</p>
    <div data-poetry>
      <h1 id="hero-title" class="hero-poem"><span data-poem-line><%= openingPoem.lines[0] %></span><span data-poem-line><%= openingPoem.lines[1] %></span></h1>
      <p class="poem-attribution"><span class="poem-rule" aria-hidden="true"></span><span data-poem-author><%= openingPoem.dynasty %> · <%= openingPoem.author %></span><cite><a data-poem-source href="<%= openingPoem.source %>" target="_blank" rel="noopener noreferrer">《<%= openingPoem.title %>》</a></cite></p>
      <script type="application/json" id="hero-poems"><%- JSON.stringify(poems).replace(/</g, '\\u003c') %></script>
    </div>
    <p class="hero-description">我是 <strong>PushyTao</strong>，欢迎来到我的数字花园。<br>在代码与文字之间，记录探索，分享发现。</p>
    <div class="hero-actions"><a class="button button-primary" href="#latest">探索文章 <svg><use href="#i-arrow"/></svg></a><a class="button button-quiet" href="https://github.com/PushyTao" target="_blank" rel="noopener noreferrer"><svg><use href="#i-github"/></svg> GitHub <span>↗</span></a></div>
    <div class="hero-signature poetry-signature"><span>以文字留住灵感，以代码探索远方。</span><span class="signature-line"></span></div>
  </div></div>
  <div class="orbit-caption" aria-hidden="true"><span class="crosshair">+</span><span>IDEAS IN ORBIT<br><small>EVERY THOUGHT, A NEW POSSIBILITY</small></span></div>
  <a class="scroll-cue" href="#latest"><span>SCROLL TO EXPLORE</span><span>↓</span></a>
</section>
<div class="content-shell home-content" id="latest">
  <section class="article-feed" aria-labelledby="latest-title">
    <div class="section-heading"><div><p class="eyebrow">THE JOURNAL</p><h2 id="latest-title">最近更新<span class="tiny-dot"></span></h2></div><a class="text-link" href="<%- url_for('/archives/') %>">全部文章 <svg><use href="#i-arrow"/></svg></a></div>
    <div class="filter-bar" role="group" aria-label="按专题筛选文章"><button data-filter="all" class="active" aria-pressed="true">全部<span><%= page.posts.length %></span></button><% site.categories.sort('name').forEach(category => { %><button data-filter="<%= category.name %>" aria-pressed="false"><%= category.name %></button><% }); %><span class="filter-meta" id="filter-count"><%= page.posts.length %> 篇文章</span></div>
    <div class="post-list"><% page.posts.each((post) => { %><%- partial('_partial/card', {post: post}) %><% }); %></div>
    <p id="filter-empty" class="empty-state" hidden>当前页暂无该专题文章。<a href="<%- url_for('/topics/') %>">前往专题页查看全部文章 →</a></p>
    <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'← 上一页',next_text:'下一页 →'}) %></nav><% } %>
    <div class="feed-end"><span></span><p>每一次记录，都是新的起点。</p><span></span></div>
  </section>
  <%- partial('_partial/sidebar') %>
</div>
