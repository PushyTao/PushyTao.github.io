<div class="reading-controls" data-reading-controls role="group" aria-label="调整正文字号" hidden>
  <span class="reading-controls-label" id="reading-size-label">正文字号</span>
  <div class="reading-controls-actions">
    <div class="reading-size-stepper">
      <button type="button" data-font-decrease aria-label="缩小正文字号" aria-controls="article-content" title="缩小字号">A−</button>
      <output data-font-value aria-labelledby="reading-size-label" aria-live="polite" aria-atomic="true">15px</output>
      <button type="button" data-font-increase aria-label="放大正文字号" aria-controls="article-content" title="放大字号">A+</button>
    </div>
    <button type="button" class="reading-size-reset" data-font-reset aria-label="重置正文字号为 15px" aria-controls="article-content">重置</button>
  </div>
</div>
