<section class="page-banner content-shell"><p class="eyebrow">CONNECTED IDEAS</p><h1>探索专题<span class="cyan">.</span></h1><p>让零散的知识连成线，找到你感兴趣的方向。</p></section>
<div class="content-shell topics-shell"><div class="topic-grid"><% site.categories.sort('name').each((category,i) => { %><a class="topic-tile" href="<%- url_for(category.path) %>"><span class="topic-tile-number">0<%= i+1 %> / COLLECTION</span><svg><use href="#i-code"/></svg><h2><%= category.name %></h2><div><span><%= category.length %> 篇文章</span><span>探索专题 ↗</span></div></a><% }); %></div><section class="tag-section" id="tags"><p class="eyebrow">FOLLOW A THREAD</p><h2>标签索引</h2><div class="tag-cloud"><% site.tags.sort('name').each(tag => { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %><span><%= tag.length %></span></a><% }); %></div></section></div>
